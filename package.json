{
  "name": "clb-ready",
  "private": true,
  "version": "0.1.0",
  "description": "Free, private AI coach for CELPIP-style speaking, writing, reading and listening practice. Runs entirely in the browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
