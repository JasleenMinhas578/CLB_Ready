    "typecheck": "tsc --noEmit",
    "audio": "tsx scripts/make-audio.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.0",
    "@mlc-ai/web-llm": "^0.2.79",
    "kokoro-js": "^1.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
